<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_translucent">

    <FrameLayout
        android:id="@+id/dial_stage"
        android:layout_width="216dp"
        android:layout_height="216dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/dial_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_midnight_face_master"
            android:contentDescription="@string/dial_widget_description" />

        <!-- LEFT COMPLICATION: whole block is centered on the 9–3 axis. -->
        <LinearLayout
            android:id="@+id/dial_weather_block"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="37dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dial_weather_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_midnight_weather_cloud" />

            <TextView
                android:id="@+id/dial_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="72°"
                android:textColor="#F5F8FA"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/dial_weather_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Partly Cloudy"
                android:textColor="#00D5FF"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- RIGHT COMPLICATION: mirrored and centered on the same horizontal axis. -->
        <LinearLayout
            android:id="@+id/dial_humidity_block"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="37dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dial_humidity_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_midnight_humidity" />

            <TextView
                android:id="@+id/dial_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="48%"
                android:textColor="#F5F8FA"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="Humidity"
                android:textColor="#00D5FF"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- Date + atomic offset stay entirely inside the protected inner ring. -->
        <LinearLayout
            android:id="@+id/dial_info_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="139dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/dial_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="#F5F8FA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dial_drift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="+148 ms"
                android:textColor="#00D5FF"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dial_status"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <!-- HANDS ARE LAST: they are always the top visual layer. -->
        <AnalogClock
            android:id="@+id/dial_analog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:dial="@drawable/widget_dial_transparent"
            android:hand_hour="@drawable/widget_midnight_hand_hour"
            android:hand_minute="@drawable/widget_midnight_hand_minute"
            android:hand_second="@drawable/widget_midnight_hand_second"
            android:contentDescription="@string/dial_widget_description" />

        <!-- Retained only for RemoteViews compatibility; digital time is intentionally absent. -->
        <TextClock
            android:id="@+id/dial_clock"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
